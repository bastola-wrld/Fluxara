# Copy this file to .env and fill it in. Never commit .env.

# ── Database (Postgres with the PostGIS extension) ──
POSTGRES_USER=fluxara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fluxara
# Use host "db" inside docker compose, "localhost" when running on your machine.
DATABASE_URL=postgresql+asyncpg://fluxara:change-me@localhost:5433/fluxara

# ── API security ──
# development | production. The shared dev key below only works in development.
FLUXARA_ENV=development
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLUXARA_SECRET_KEY=
# Optional, development only. Leave empty in production.
FLUXARA_DEV_KEY=
# Comma separated list of frontend origins allowed to call the API.
FLUXARA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── First admin user (used once by scripts/seed_admin.py) ──
FLUXARA_ADMIN_EMAIL=
FLUXARA_ADMIN_PASSWORD=

# ── Data sources ──
# Free NASA Earthdata token, needed for EMIT emission rates.
# https://urs.earthdata.nasa.gov  ->  Generate Token
EARTHDATA_TOKEN=

# Free Copernicus Data Space account, needed to download Sentinel 2 images.
# https://dataspace.copernicus.eu  ->  Register
CDSE_USERNAME=
CDSE_PASSWORD=

# Free Climate Data Store account, needed for ERA5 wind.
# https://cds.climate.copernicus.eu  ->  your profile  ->  API key
# Also accept the ERA5 licence once on the dataset's download page.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Where downloaded images and wind files are kept.
FLUXARA_CACHE_DIR=satellite_data/cache

# ── Feature flags ──
# Old neural inversion route. Experimental and unvalidated. Needs torch.
FLUXARA_ENABLE_LEGACY_INVERSION=false
# Old PDF report templates. They print 0.0 kg/hr for sites with no data. Keep off.
FLUXARA_ENABLE_LEGACY_REPORTS=false
# Regenerate PDF reports at startup and nightly. Keep off until reports use real data.
FLUXARA_AUTO_GENERATE_PDFS=false
